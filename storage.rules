rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function emailVerified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function entitlementDoc() {
      return firestore.get(/databases/(default)/documents/entitlements/$(request.auth.uid));
    }

    function paymentPolicyDoc() {
      return firestore.get(/databases/(default)/documents/systemSettings/paymentPolicy);
    }

    function hasRevokedAccess() {
      return firestore.exists(/databases/(default)/documents/entitlements/$(request.auth.uid))
        && entitlementDoc().data.status == 'revoked';
    }

    function hasActivePaidAccess() {
      return firestore.exists(/databases/(default)/documents/entitlements/$(request.auth.uid))
        && entitlementDoc().data.status == 'active'
        && entitlementDoc().data.accessExpiresAt is timestamp
        && entitlementDoc().data.accessExpiresAt > request.time;
    }

    function hasGrandfatheredAccess() {
      return firestore.exists(/databases/(default)/documents/accounts/$(request.auth.uid))
        && firestore.exists(/databases/(default)/documents/systemSettings/paymentPolicy)
        && accountDoc().data.createdAt is timestamp
        && paymentPolicyDoc().data.existingAccountAccessActivatedAt is timestamp
        && paymentPolicyDoc().data.existingAccountAccessExpiresAt is timestamp
        && accountDoc().data.createdAt < paymentPolicyDoc().data.existingAccountAccessActivatedAt
        && paymentPolicyDoc().data.existingAccountAccessExpiresAt > request.time;
    }

    function hasActiveAccess() {
      return !hasRevokedAccess() && (hasActivePaidAccess() || hasGrandfatheredAccess());
    }

    function accountDoc() {
      return firestore.get(/databases/(default)/documents/accounts/$(request.auth.uid));
    }

    function hasPublicAccountRole() {
      return firestore.exists(/databases/(default)/documents/accounts/$(request.auth.uid))
        && (accountDoc().data.role == 'student' || accountDoc().data.role == 'sponsor');
    }

    function activeUser() {
      return emailVerified() && hasActiveAccess() && hasPublicAccountRole();
    }

    function organizationDoc(orgId) {
      return firestore.get(/databases/(default)/documents/organizations/$(orgId));
    }

    function isOrganizationOwner(orgId) {
      return activeUser()
        && firestore.exists(/databases/(default)/documents/organizations/$(orgId))
        && organizationDoc(orgId).data.ownerUid == request.auth.uid;
    }

    function hasActiveOfficerGrant(orgId) {
      return activeUser()
        && firestore.exists(/databases/(default)/documents/organizations/$(orgId)/officerGrants/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/organizations/$(orgId)/officerGrants/$(request.auth.uid)).data.status == 'active';
    }

    function canManageOrganization(orgId) {
      return isOrganizationOwner(orgId) || hasActiveOfficerGrant(orgId);
    }

    function validImageUpload() {
      return request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    function validMeetingDocumentUpload(orgId, requestId) {
      return request.resource != null
        && activeUser()
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType == 'application/pdf'
        && request.resource.metadata.orgId == orgId
        && request.resource.metadata.meetingRequestId == requestId
        && request.resource.metadata.requesterUid == request.auth.uid;
    }

    match /organization-logos/{orgId}/{fileName} {
      allow read: if activeUser();
      allow write: if canManageOrganization(orgId) && validImageUpload();
      allow delete: if canManageOrganization(orgId);
    }

    match /announcement-images/{orgId}/{announcementId}/{fileName} {
      allow read: if activeUser();
      allow write: if canManageOrganization(orgId) && validImageUpload();
      allow delete: if canManageOrganization(orgId);
    }

    match /meeting-request-documents/{orgId}/{requestId}/{fileName} {
      allow read: if false;
      allow write: if validMeetingDocumentUpload(orgId, requestId);
      allow delete: if activeUser() && resource.metadata.requesterUid == request.auth.uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
