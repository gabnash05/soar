# SOAR frontend environment
# Use development fixtures only for local UI work and tests. Do not set this for production.
VITE_SOAR_USE_FIXTURES=false

# Backend foundation API. Required for production auth/payment/access/settings calls.
VITE_SOAR_API_BASE_URL=

# Set to supabase only for the Render Free preview; Firebase Storage remains the default for Functions/emulators.
VITE_SOAR_STORAGE_PROVIDER=firebase
# Disable until a reviewed same-site registration binding and an approved payment environment exist.
VITE_SOAR_PAYMENTS_ENABLED=false

# Public Firebase web config. These are public client identifiers, not Admin SDK secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional local emulator hosts. For the checked-in backend helper use:
# VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:19099
# VITE_FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:19199
VITE_FIREBASE_AUTH_EMULATOR_HOST=
VITE_FIREBASE_STORAGE_EMULATOR_HOST=
