{
  "name": "@soar/backend",
  "version": "0.1.0",
  "private": true,
  "description": "SOAR Firebase backend foundation for identity, paid access contracts, and organization permissions.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "emulators:start": "bash scripts/start-local-emulators.sh",
    "emulators:seed": "node scripts/seed-local-emulator.cjs",
    "test": "npm run test:payments && npm run test:content && npm run test:admin && npm run test:identity && npm run test:requests && npm run test:http",
    "test:payments": "node --test src/payments/__tests__/payments.test.js",
    "test:content": "vitest run src/content/__tests__/*.test.ts",
    "test:admin": "vitest run src/admin/__tests__/*.test.ts",
    "test:identity": "vitest run src/identity/__tests__/*.test.ts",
    "test:requests": "vitest run test/requests.service.test.ts",
    "test:http": "vitest run test/http.routes.test.ts",
    "test:rules": "vitest run --no-file-parallelism test/firestore.rules.test.ts test/storage.rules.test.ts",
    "test:rules:firestore": "vitest run test/firestore.rules.test.ts",
    "test:rules:storage": "vitest run test/storage.rules.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "firebase-admin": "^13.5.0",
    "firebase-functions": "^6.4.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.0",
    "firebase": "^12.4.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
