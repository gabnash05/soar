# SOAR backend local/emulator configuration.
# Copy to a private .env file or configure these as Firebase/Cloud secrets.

# Existing Firebase project from the supplied TECHNO draft.
GCLOUD_PROJECT=soar-a711e
FIREBASE_CONFIG={"projectId":"soar-a711e","storageBucket":"soar-a711e.firebasestorage.app"}

# Required for the backend email-change endpoint because Firebase verify-before-change is exposed through the Auth REST API.
# Use the public web API key from the existing Firebase web app config; do not invent a new Firebase project.
SOAR_FIREBASE_WEB_API_KEY=replace-with-existing-firebase-web-api-key

# Payment provider secrets are required only for real payment endpoints.
# Use test keys locally and store production values outside the repo.
PAYMONGO_SECRET_KEY=sk_test_replace_me
PAYMONGO_WEBHOOK_SECRET=whsec_replace_me
PAYMONGO_EXPECTED_LIVEMODE=false
PAYMENT_SECRET_PEPPER=replace-with-random-local-secret
PAYMENT_SECURE_COOKIES=false
SOAR_APP_BASE_URL=http://localhost:5173

# Emulator hosts are set automatically by firebase emulators:exec.
# For manual local testing only:
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
